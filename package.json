    "test:e2e": "playwright test",
    "typecheck": "tsc -b --noEmit false --emitDeclarationOnly false"
  },
  "dependencies": {
    "decimal.js": "^10.4.3",
    "dexie": "^4.0.11",
    "exceljs": "^4.4.0",
