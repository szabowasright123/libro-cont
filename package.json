{
  "name": "libro-hesperides",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "description": "Libro Hespérides — Libro contable y Archivo probatorio del Taller de Bitcoin (Universidad de las Hespérides). App web local-first.",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
